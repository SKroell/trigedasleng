# ---- Database (read-only) -------------------------------------------------
# Defaults to <repo>/prisma/dev.db. Override only if the DB lives elsewhere.
# TRIG_DB_PATH=../prisma/dev.db

# ---- Retrieval mode -------------------------------------------------------
# full   : send the ENTIRE corpus to the model every query. No embedder, no
#          torch/sentence-transformers — just the Anthropic key. Best grounding;
#          prompt-cached so repeat queries are cheap. Great for this small corpus.
# vector : embed the corpus and retrieve a type-aware quota per query. Cheaper
#          per query at scale; needs an embedder (EMBEDDER_MODEL below).
RETRIEVAL_MODE=full

# ---- Embedder (only used when RETRIEVAL_MODE=vector) -----------------------
# EMBEDDER: fastembed | sentence-transformers | stub
#   fastembed             = ONNX runtime, NO PyTorch (~tens of MB). Best for a
#                           CPU-only server. Install: pip install fastembed
#   sentence-transformers = PyTorch (GPU-capable; pulls ~2GB unless you install
#                           the CPU torch wheel first).
#   stub                  = no-deps offline smoke test (no real semantics).
EMBEDDER=fastembed
# bge-small (~130MB) for local; bump to BAAI/bge-large-en-v1.5 on the HPC.
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
# bge-* models want a query instruction; passages get no prefix. Swap both for
# e5-style models (EMBEDDER_QUERY_PREFIX="query: " / EMBEDDER_DOC_PREFIX="passage: ").
EMBEDDER_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBEDDER_DOC_PREFIX=

# ---- LLM backend ----------------------------------------------------------
# LLM_BACKEND: anthropic | openai | none  (none = retrieval-only, no model call)
LLM_BACKEND=anthropic

# Anthropic API (managed alternative; works today with a key).
# Uses adaptive thinking; do not set temperature (removed on Opus 4.7+).
# claude-opus-4-8 = most capable. For a high-volume public chatbot, claude-sonnet-4-6
# is a cheaper, still-capable choice (both support adaptive thinking; needs a 4.6+ model).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_MAX_TOKENS=4096
# Adaptive thinking is OFF by default (it adds output-token cost over the big
# full-context corpus). Set to "adaptive" if you want more careful reasoning.
# ANTHROPIC_THINKING=off
# Prompt-cache TTL for the full-context corpus. "1h" keeps it warm across a
# testing session (write once, cheap reads for an hour); "5m" is the cheaper
# first-write but expires fast. Only matters in RETRIEVAL_MODE=full.
# ANTHROPIC_CACHE_TTL=1h

# OpenAI-compatible endpoint (self-hosted vLLM / TGI on your HPC)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Service --------------------------------------------------------------
RAG_HOST=127.0.0.1
RAG_PORT=8000
RAG_CORPUS=corpus.jsonl
# Per-type retrieval quotas (type-aware, not flat top-k). Only used in vector mode.
RAG_QUOTA_DICTIONARY=10
RAG_QUOTA_TRANSLATION=8
RAG_QUOTA_GRAMMAR=4
# Hybrid retrieval (vector mode): dictionary entries whose headword/gloss exactly
# matches a query word are force-included, and a lexical signal is blended into the
# dense ranking — so attested words aren't missed just because they embed poorly.
# RAG_LEX_WEIGHT controls the blend (0 = dense only; higher = more lexical).
RAG_LEX_WEIGHT=0.35
